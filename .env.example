# UNIQUE EXPRESSIONS - ENVIRONMENT VARIABLE TEMPLATE
PORT=5000

# CLOUDINARY API CONFIGURATION
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=unique_expressions

# SUPABASE DATABASE CONFIGURATION
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Database password (Project Settings → Database) — needed only to run: npm run db:policies
SUPABASE_DB_PASSWORD=your_database_password
# Optional: full connection string if auto-detect region fails
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# RAZORPAY PAYMENT GATEWAY CONFIGURATION
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

